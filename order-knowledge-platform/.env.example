# Copier en .env et adapter. Ne jamais committer .env.
OKP_ENV=dev                       # dev | prod  (en prod, OKP_AUDIT_HMAC_KEY est obligatoire)
OKP_DATA_DIR=./data               # base core/KG + sources simulées
OKP_DB_PATH=./data/okp.sqlite
OKP_SOURCES_DIR=./data/sources
OKP_MODELS_DIR=./models
OKP_PRINCIPALS_FILE=./config/principals.demo.yaml
# Clé HMAC du chaînage du journal d'audit (secret). Générer : python -c "import secrets;print(secrets.token_hex(32))"
OKP_AUDIT_HMAC_KEY=change-me
# Clé utilisée par le serveur MCP pour s'authentifier (identité de l'utilisateur délégant).
OKP_API_KEY=demo-analyst-key

# Clés de DÉMONSTRATION (empreintes dans config/principals.demo.yaml) :
#   alice.admin    demo-admin-key
#   bruno.manager  demo-manager-key
#   chloe.rep      demo-rep-idf-key     (région IDF)
#   david.rep      demo-rep-ara-key     (régions ARA, OCC)
#   emma.ops       demo-ops-lyon-key    (entrepôt LYS1)
#   farid.analyst  demo-analyst-key
#   ingest.bot     demo-ingest-key
