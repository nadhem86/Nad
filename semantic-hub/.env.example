# Copier en .env et adapter. NE JAMAIS versionner de vrais secrets.

# Stockage
NAD_DB_PATH=./var/hub.sqlite
NAD_BUSINESS_TZ=Europe/Paris
NAD_DEFAULT_PHONE_REGION=FR

# Principaux (jetons -> rôles). En production : annuaire d'entreprise ; ce fichier ne contient que des empreintes.
NAD_PRINCIPALS_FILE=./security/principals.demo.yaml

# Passerelles d'écriture vers les sources : simulated (démo) | live (vTiger réel)
NAD_GATEWAY_MODE=simulated
# Requis si NAD_GATEWAY_MODE=live ou pour `hub.cli extract-vtiger`. Clé : vTiger > Mon profil > Avancé > Clé d'accès.
NAD_VTIGER_URL=
NAD_VTIGER_USERNAME=
NAD_VTIGER_ACCESS_KEY=

# Jeton du principal utilisé par le serveur MCP (fixé côté serveur, jamais par l'agent).
NAD_MCP_TOKEN=demo-agent-nord

# Jetons de DÉMONSTRATION (empreintes dans security/principals.demo.yaml) :
#   demo-admin, demo-commercial-nord, demo-commercial-sud, demo-logisticien-lille, demo-analyste, demo-agent-nord
